# Copy to .env (Docker Compose reads it). Any config.toml value can be set as
# WXBOT_<SECTION>__<KEY>.
WXBOT_APP__HOST=0.0.0.0
WXBOT_APP__LOG_JSON=true
# Protect the dashboard when it is reachable from the internet:
WXBOT_APP__DASHBOARD_PASSWORD=change-me
# PostgreSQL instead of SQLite (also add psycopg[binary] to requirements.txt):
# WXBOT_APP__DATABASE_URL=postgresql+psycopg://wxbot:secret@db:5432/wxbot
