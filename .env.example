# Copy to .env next to docker-compose.yml (Docker Compose and the systemd unit
# read it). Any config.toml value can be set as WXBOT_<SECTION>__<KEY>; these
# are the ones a server usually needs. Never commit .env: it is gitignored and
# kept out of the Docker image. PAPER TRADING ONLY: compose forces paper mode.

# --- dashboard ---------------------------------------------------------------
# Docker publishes the dashboard on this machine only (127.0.0.1). Use
# 0.0.0.0 to reach it from the internet, and then set a password:
# WXBOT_DASHBOARD_BIND=0.0.0.0
WXBOT_APP__DASHBOARD_PASSWORD=change-me

# --- runtime -----------------------------------------------------------------
WXBOT_APP__LOG_JSON=true
# WXBOT_SCHEDULE__CYCLE_MINUTES=30

# --- experiment --------------------------------------------------------------
# A database holds one experiment; it refuses a different starting bankroll.
# WXBOT_EXPERIMENT__NAME=paper-100
# WXBOT_BANKROLL__INITIAL=100

# --- model -------------------------------------------------------------------
# false keeps the station bias/spread fixed (no weekly retraining)
# WXBOT_LEARNING__ENABLED=true

# --- database ----------------------------------------------------------------
# PostgreSQL instead of SQLite (also add psycopg[binary] to requirements.txt):
# WXBOT_APP__DATABASE_URL=postgresql+psycopg://wxbot:secret@db:5432/wxbot

# --- first start ---------------------------------------------------------------
# false skips loading observation history and the first bias/spread fit
# WXBOT_BOOTSTRAP=true

# The bot uses only public APIs (Polymarket, Open-Meteo, Iowa Environmental
# Mesonet), so it needs no API keys. There are no notifications yet.
